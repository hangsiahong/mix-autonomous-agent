# AMA secrets — copy this to .env and fill in your values
# Never commit .env to git

TG_TOKEN=your-telegram-bot-token
TG_ADMIN=your-telegram-user-id

# Provider: google (Vertex AI), anthropic, openai
PROVIDER=google

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
# MODEL=gemini-2.0-flash

# Anthropic (alternative)
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-opus-4-5

# OpenAI (alternative)
# PROVIDER=openai
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o

# Concurrency limits
# MAX_CONCURRENT_AGENTS=10    # global cap across all users
# MAX_AGENTS_PER_USER=3       # per-user cap (important for groups — prevents one user hogging all slots)
