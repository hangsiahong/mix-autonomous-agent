# AMA secrets — copy this to .env and fill in your values
# Never commit .env to git

# Docker user — prevents "Permission denied" when accessing mounted volumes from host.
# Run this once and paste the output here:
#   echo "UID=$(id -u)" && echo "GID=$(id -g)"
# UID=1000
# GID=1000

TG_TOKEN=your-telegram-bot-token
TG_ADMIN=your-telegram-user-id

# Provider: google (Vertex AI), anthropic, openai
PROVIDER=google

# Google Vertex AI
# NOTE: variable names are GOOGLE_PROJECT / GOOGLE_REGION (NOT the gcloud-style
# GOOGLE_CLOUD_*). The bash + Python code in core/ and tools/ read these names.
GOOGLE_PROJECT=your-gcp-project-id
GOOGLE_REGION=global       # use 'global' for Gemini 3.x preview; otherwise e.g. us-central1
# GOOGLE_MODE=vertex       # default; set to 'studio' for AI Studio + GOOGLE_API_KEY
# MODEL=gemini-3-flash-preview

# Anthropic (alternative)
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-opus-4-5

# OpenAI (alternative)
# PROVIDER=openai
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o

# Concurrency limits
# MAX_CONCURRENT_AGENTS=10    # global cap across all users
# MAX_AGENTS_PER_USER=3       # per-user cap (important for groups — prevents one user hogging all slots)

# Workspace directory — where the agent creates and edits real projects
# When set, write_file / edit_code / patch can write here (not just inside the harness)
# The agent will also default new projects here when no path is specified
# WORKSPACE_DIR=/home/user/projects
